<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The headphones are already bonded to this phone, so there is nothing to
         discover and no BLUETOOTH_SCAN here: opening an RFCOMM socket to a bonded
         device needs BLUETOOTH_CONNECT alone. Grant it with
         `adb shell pm grant org.xinutec.volume android.permission.BLUETOOTH_CONNECT`
         — the probe is driven headlessly and never shows a permission dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:allowBackup="false"
        android:label="Volume probe"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- exported so `adb shell am start` can drive it with string extras (see
             probe.sh). This is a sideloaded probe on a personal phone; when #785
             decides the real app's shape this activity does not survive into it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
