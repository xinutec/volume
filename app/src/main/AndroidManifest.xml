<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The headphones are already bonded to this phone, so there is nothing to
         discover and no BLUETOOTH_SCAN here: opening an RFCOMM socket to a bonded
         device needs BLUETOOTH_CONNECT alone. Grant it with
         `adb shell pm grant org.xinutec.volume android.permission.BLUETOOTH_CONNECT`
         — the probe is driven headlessly and never shows a permission dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE control channels are reached at an address that ROTATES, so the bonded
         list cannot supply it and a scan is the only way to learn the current one.
         neverForLocation keeps this off the location permission: the probe uses
         scanning to identify a device, never to place anyone. Grant it the same way:
         `adb shell pm grant org.xinutec.volume android.permission.BLUETOOTH_SCAN` -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:allowBackup="false"
        android:label="Volume"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- The app. Launcher, because this is what #785 is. -->
        <activity
            android:name=".VolumeActivity"
            android:exported="true"
            android:label="Volume">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The #783 probe. Exported so `adb shell am start` can drive it with
             string extras (see probe.sh), and NOT a launcher entry: it is an
             instrument, and it stays because it is the only thing that can
             investigate a device the app above cannot drive. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Volume probe"
            android:launchMode="singleTask" />

    </application>
</manifest>
