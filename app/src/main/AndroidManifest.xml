<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The headphones are already bonded to this phone, so there is nothing to
         discover and no BLUETOOTH_SCAN here: opening an RFCOMM socket to a bonded
         device needs BLUETOOTH_CONNECT alone. Grant it with
         `adb shell pm grant org.xinutec.volume android.permission.BLUETOOTH_CONNECT`
         — the probe is driven headlessly and never shows a permission dialog. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- The probe runs as a foreground service so `adb shell am start-foreground-service`
         can drive it: a BACKGROUND service started from the shell is refused outright,
         and a run holds an RFCOMM socket for tens of seconds, which is what the
         connectedDevice type is for. See ProbeService for why it is not an activity. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- BLE control channels are reached at an address that ROTATES, so the bonded
         list cannot supply it and a scan is the only way to learn the current one.
         neverForLocation keeps this off the location permission: the probe uses
         scanning to identify a device, never to place anyone. Grant it the same way:
         `adb shell pm grant org.xinutec.volume android.permission.BLUETOOTH_SCAN` -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- The Mac's audio, over HTTP on the LAN — the stereo pair, the microphone pin
         and the arcade cabinets. This is the app's ONLY network use: nothing here
         talks to the internet, and the one host it does talk to is named in
         `THOTH_DEFAULT_HOST` and overridable on the card.

         ⚠ `usesCleartextTraffic` on the application below went from false to TRUE for
         this, which is a loosening and not a formality. thoth has no TLS and no auth:
         it is a control panel for the speakers in one room, on the home LAN, where the
         threat is destruction rather than observation.

         ⚠ A per-domain `networkSecurityConfig` was tried first and is the WRONG answer
         here, which is worth recording because it looks like the tighter one. It can
         only name a literal address, and the whole reason the card lets the address be
         edited is that the Mac's lease moves — so the tighter config would have refused
         exactly the address somebody had just typed in to recover, and reported it as a
         cleartext violation rather than as a wrong host. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Volume"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">

        <!-- The app. Launcher, because this is what #785 is. -->
        <activity
            android:name=".VolumeActivity"
            android:exported="true"
            android:label="Volume">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The #783 probe. Exported so `adb shell am start` can drive it with
             string extras (see probe.sh), and NOT a launcher entry: it is an
             instrument, and it stays because it is the only thing that can
             investigate a device the app above cannot drive. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Volume probe"
            android:launchMode="singleTask" />

        <!-- The #783 probe's real entry point. ⚠ **Not the activity above**, which
             `am start` can decline to deliver to while reporting success — see
             ProbeService and #967. Exported for the same reason MainActivity is: the
             shell is what drives it. -->
        <service
            android:name=".ProbeService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />

        <!-- ANC from the Quick Settings shade. This is the thing a native app can do
             that a web page cannot, and it is why #785 went native.

             ⚠ `BIND_QUICK_SETTINGS_TILE` is granted to the SYSTEM, not requested by
             us: it is what stops any app binding a tile service. Without it the tile
             never appears in the editor, with no error anywhere.

             ⚠ `activeTile` is deliberately NOT set. It makes the system ask the
             service to refresh even while the shade is shut, and answering that
             honestly would mean opening a control channel to a headphone nobody is
             looking at — the exact thing `onStop`'s release exists to stop. The tile
             reads its cheap state when the shade opens instead. -->
        <service
            android:name=".AncTileService"
            android:exported="true"
            android:icon="@drawable/ic_anc"
            android:label="Noise cancelling"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The same one tap on the home screen. ⚠ Exported, because the launcher
             and the AppWidgetManager are what send to it; the custom tap action is
             delivered through an IMMUTABLE PendingIntent, so nothing else can
             retarget it. -->
        <receiver
            android:name=".AncWidget"
            android:exported="true"
            android:label="Noise cancelling">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.xinutec.volume.WIDGET_TAP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anc_widget_info" />
        </receiver>

    </application>
</manifest>
