{
  "checks": [
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD",
        "--",
        "--baseline",
        ".dev-lint-baseline",
        "."
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "dev-lint (baselined)",
      "timeout_s": 900
    },
    {
